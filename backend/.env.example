# ─────────────────────────────────────────────────────────────────────────
# BondGis backend — exemplo de variáveis de ambiente.
# Copie para "backend/.env" e preencha. NUNCA versione o .env real.
# ─────────────────────────────────────────────────────────────────────────

# Projeto do Google Cloud habilitado para Earth Engine (obrigatório).
EE_PROJECT=seu-projeto-gcp

# Service account com acesso ao Earth Engine.
EE_SERVICE_ACCOUNT_EMAIL=bondgis-ee@seu-projeto-gcp.iam.gserviceaccount.com

# Chave privada da service account — use UMA das duas opções:
#  (a) DEV local: caminho para o arquivo .json baixado do Google Cloud.
EE_SERVICE_ACCOUNT_KEY_FILE=./service-account-key.json
#  (b) DEPLOY: cole o conteúdo do JSON inteiro em uma linha (escape as quebras).
#      Deixe (a) em branco se usar esta.
# EE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account","project_id":"..."}

# Origens autorizadas (CORS), separadas por vírgula.
# Inclua o dev server local e o GitHub Pages.
ALLOWED_ORIGINS=http://localhost:8321,http://127.0.0.1:8321,https://bondkk07.github.io

# Porta do servidor (Render/Cloud Run injetam PORT automaticamente).
PORT=8000

# Sentinel-2 (padrões recomendados — normalmente não precisa mudar).
S2_COLLECTION=COPERNICUS/S2_SR_HARMONIZED
STATS_SCALE=10
