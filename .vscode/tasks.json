{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BondGis: iniciar servidor local",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/serve.ps1"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^(Serving.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Serving",
          "endsPattern": "^Serving"
        }
      }
    },
    {
      "label": "BondGis: backend Earth Engine (uvicorn)",
      "type": "shell",
      "command": "uvicorn",
      "args": ["main:app", "--reload", "--port", "8000"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": {
        "pattern": { "regexp": "^(Uvicorn running.*)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Uvicorn running",
          "endsPattern": "Application startup complete"
        }
      }
    }
  ]
}
